{
  "extends": "default",
  "meta": {
    "name": "ajax-agent",
    "version": "1.0.0",
    "description": "Ajax task agent"
  },
  "groups": {
    "include": [
      {
        "name": "user_caches_macos",
        "when": "macos"
      },
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.cache/claude",
      "$HOME/.local/state/claude",
      "$HOME/.codex",
      "$HOME/.pi",
      "$HOME/.cursor",
      "$HOME/.config/cursor",
      "$HOME/.npm",
      "$HOME/.cargo/registry",
      "$HOME/.cargo/git"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock",
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains/metadata.keychain-db",
        "when": "macos"
      }
    ],
    "bypass_protection": [
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains/metadata.keychain-db",
        "when": "macos"
      }
    ],
    "read": [
      "$HOME/.local/share/cursor-agent",
      "$HOME/.local/share/claude"
    ],
    "read_file": [
      {
        "path": "$HOME/.orbstack/ssh/config",
        "when": "macos"
      }
    ],
    "deny": [
      {
        "path": "/private/tmp/tmux-$UID",
        "when": "macos"
      },
      {
        "path": "/tmp/tmux-$UID",
        "when": "linux"
      },
      {
        "path": "$HOME/.orbstack/run",
        "when": "macos"
      },
      {
        "path": "/private/var/run/docker.sock",
        "when": "macos"
      },
      {
        "path": "$HOME/.colima",
        "when": "macos"
      },
      {
        "path": "$HOME/.lima",
        "when": "macos"
      },
      {
        "path": "$HOME/.rd",
        "when": "macos"
      },
      {
        "path": "$HOME/.docker",
        "when": "macos"
      },
      {
        "path": "$HOME/.local/share/containers",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Containers/com.docker.docker",
        "when": "macos"
      },
      {
        "path": "$HOME/.config/colima",
        "when": "macos"
      },
      {
        "path": "/private/tmp/.s.PGSQL.5432",
        "when": "macos"
      }
    ]
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "readwrite"
  }
}