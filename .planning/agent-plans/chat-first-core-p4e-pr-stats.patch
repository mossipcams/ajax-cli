+struct StatsRunner {
+    prs: String,
+    checks: String,
+    stats: Option<String>,
+    commands: Vec<CommandSpec>,
+}
+
+impl CommandRunner for StatsRunner {
+    fn run(&mut self, command: &CommandSpec) -> Result<CommandOutput, CommandRunError> {
+        self.commands.push(command.clone());
+        let is_view = command.args.get(1).is_some_and(|arg| arg == "view");
+        if is_view {
+            return match &self.stats {
+                Some(stdout) => Ok(CommandOutput {
+                    status_code: 0,
+                    stdout: stdout.clone(),
+                    stderr: String::new(),
+                }),
+                None => Err(CommandRunError::SpawnFailed("gh unavailable".to_string())),
+            };
+        }
+        let stdout = if command.args.get(1).is_some_and(|arg| arg == "list") {
+            self.prs.clone()
+        } else {
+            self.checks.clone()
+        };
+        Ok(CommandOutput {
+            status_code: 0,
+            stdout,
+            stderr: String::new(),
+        })
+    }
+}
