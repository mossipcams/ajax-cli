+fn refresh_pr_stats(
+    task: &mut Task,
+    runner: &mut impl CommandRunner,
+    github: &GithubChecksAdapter,
+    number: u64,
+) {
+    let command = github.pr_view_stats(&task.worktree_path.display().to_string(), number);
+    if let Ok((additions, deletions)) =
+        GithubChecksAdapter::parse_pr_view_stats(&runner.run(&command))
+    {
+        remember_pull_request_stats(
+            task,
+            PullRequestStats {
+                number,
+                additions,
+                deletions,
+            },
+        );
+    }
