{
  "version": 1,
  "approvalMode": "allowlist",
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(exploratory-results/**)",
      "Write(target/exploratory-instance/**)",
      "Mcp(playwright, **)"
    ],
    "deny": [
      "Shell(**)",
      "Write(exploratory-results/verifier/**)",
      "Write(crates/**)",
      "Write(.github/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(Cargo.toml)",
      "Write(Cargo.lock)",
      "Write(**/*.rs)",
      "Write(**/*.ts)",
      "Write(**/*.tsx)",
      "Write(**/*.jsx)",
      "Write(**/*.css)",
      "Write(**/*.toml)",
      "Write(**/*.yml)",
      "Write(**/*.yaml)"
    ]
  },
  "sandbox": {
    "mode": "enabled",
    "networkAccess": "deny"
  },
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  }
}
