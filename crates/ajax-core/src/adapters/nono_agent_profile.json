{
  "extends": "default",
  "allow_parent_of_protected": true,
  "meta": {
    "name": "ajax-agent",
    "version": "1.0.0",
    "description": "Ajax task agent"
  },
  "groups": {
    "include": [
      {
        "name": "user_caches_macos",
        "when": "macos"
      },
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "nix_runtime",
      "git_config"
    ]
  },
  "filesystem": {
    "allow": [
      {
        "path": "$HOME",
        "when": "macos"
      },
      {
        "path": "$HOME/.claude",
        "when": "linux"
      },
      {
        "path": "$HOME/.cache/claude",
        "when": "linux"
      },
      {
        "path": "$HOME/.local/state/claude",
        "when": "linux"
      },
      {
        "path": "$HOME/.codex",
        "when": "linux"
      },
      {
        "path": "$HOME/.pi",
        "when": "linux"
      },
      {
        "path": "$HOME/.cursor",
        "when": "linux"
      },
      {
        "path": "$HOME/.config/cursor",
        "when": "linux"
      },
      {
        "path": "$HOME/.npm",
        "when": "linux"
      },
      {
        "path": "$HOME/.cargo/registry",
        "when": "linux"
      },
      {
        "path": "$HOME/.cargo/git",
        "when": "linux"
      },
      {
        "path": "/opt/homebrew",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains",
        "when": "macos"
      }
    ],
    "allow_file": [
      {
        "path": "$HOME/.claude.json",
        "when": "linux"
      },
      {
        "path": "$HOME/.claude.json.lock",
        "when": "linux"
      },
      {
        "path": "$HOME/.claude.lock",
        "when": "linux"
      },
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains/metadata.keychain-db",
        "when": "macos"
      }
    ],
    "bypass_protection": [
      {
        "path": "$HOME/Library/Keychains/login.keychain-db",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains/metadata.keychain-db",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Keychains",
        "when": "macos"
      }
    ],
    "read": [
      {
        "path": "$HOME/.local/share/cursor-agent",
        "when": "linux"
      },
      {
        "path": "$HOME/.local/share/claude",
        "when": "linux"
      }
    ],
    "deny": [
      {
        "path": "/private/tmp/tmux-$UID",
        "when": "macos"
      },
      {
        "path": "/tmp/tmux-$UID",
        "when": "linux"
      },
      {
        "path": "$HOME/.orbstack/run",
        "when": "macos"
      },
      {
        "path": "$HOME/.orbstack/ssh/id_ed25519",
        "when": "macos"
      },
      {
        "path": "/private/var/run/docker.sock",
        "when": "macos"
      },
      {
        "path": "$HOME/.colima",
        "when": "macos"
      },
      {
        "path": "$HOME/.lima",
        "when": "macos"
      },
      {
        "path": "$HOME/.rd",
        "when": "macos"
      },
      {
        "path": "$HOME/.docker",
        "when": "macos"
      },
      {
        "path": "$HOME/.local/share/containers",
        "when": "macos"
      },
      {
        "path": "$HOME/Library/Containers/com.docker.docker",
        "when": "macos"
      },
      {
        "path": "$HOME/.config/colima",
        "when": "macos"
      },
      {
        "path": "/private/tmp/.s.PGSQL.5432",
        "when": "macos"
      },
      "$HOME/.config/ajax/nono",
      "$HOME/.config/ajax/config.toml",
      "$HOME/.local/state/ajax/ajax.db",
      "$HOME/.local/state/ajax/ajax.db-wal",
      "$HOME/.local/state/ajax/ajax.db-shm",
      "$HOME/.ajax-dev/config.toml",
      "$HOME/.ajax-dev/ajax.db",
      "$HOME/.ajax-dev/ajax.db-wal",
      "$HOME/.ajax-dev/ajax.db-shm",
      "$HOME/.pgpass",
      "$HOME/.pypirc",
      "$HOME/.cargo/credentials",
      "$HOME/.cargo/credentials.toml"
    ]
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "readwrite"
  }
}
