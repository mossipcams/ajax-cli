#!/usr/bin/env python3
"""Persistent Moonshine v2 (Voice) STT worker for `ajax web`.

Uses moonshine-voice with ModelArch.SMALL_STREAMING by default. Speaks the
framed protocol that `crates/ajax-web/src/adapters/stt_provider.rs` writes to
stdin, and emits newline-delimited JSON events on stdout.

stdin frames (big-endian lengths):
    start     [0][u32 len][json body]
    audio     [1][u32 sequence][u32 len][PCM16 little-endian mono]
    finalize  [2]
    cancel    [3]

stdout events (one JSON object per line):
    {"type":"stt.ready"}
    {"type":"stt.speech_started"}
    {"type":"stt.partial","sequence":N,"text":"..."}
    {"type":"stt.final","sequence":N,"text":"..."}
    {"type":"stt.speech_ended"}
    {"type":"stt.completed"}

One long-lived process loads the streaming model once and serves many
recognition sessions. Cancel/finalize end a session without exiting the worker.
Ajax kills the process only on provider shutdown. Diagnostics go to AJAX_STT_LOG.

Requires: pip install moonshine-voice numpy
Does not use legacy useful-moonshine-onnx / moonshine/tiny.
"""

from __future__ import annotations

import json
import os
import queue
import struct
import sys
import threading
import time
from dataclasses import dataclass

FRAME_START = 0
FRAME_AUDIO = 1
FRAME_FINALIZE = 2
FRAME_CANCEL = 3

SAMPLE_WIDTH = 2
AUDIO_QUEUE_MAX = 100


def _log(message: str) -> None:
    path = os.environ.get("AJAX_STT_LOG")
    if not path:
        return
    try:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(f"{time.time():.3f} {message}\n")
    except OSError:
        pass


def _emit(event: dict) -> None:
    sys.stdout.write(json.dumps(event, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _read_exactly(stream, count: int) -> bytes | None:
    chunks = []
    remaining = count
    while remaining > 0:
        chunk = stream.read(remaining)
        if not chunk:
            return None
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def _read_frame(stream):
    kind_byte = _read_exactly(stream, 1)
    if kind_byte is None:
        return None
    kind = kind_byte[0]

    if kind in (FRAME_FINALIZE, FRAME_CANCEL):
        return (kind, None, b"")

    if kind == FRAME_START:
        raw_len = _read_exactly(stream, 4)
        if raw_len is None:
            return None
        (length,) = struct.unpack(">I", raw_len)
        body = _read_exactly(stream, length) if length else b""
        if body is None:
            return None
        return (kind, None, body)

    if kind == FRAME_AUDIO:
        header = _read_exactly(stream, 8)
        if header is None:
            return None
        sequence, length = struct.unpack(">II", header)
        payload = _read_exactly(stream, length) if length else b""
        if payload is None:
            return None
        return (kind, sequence, payload)

    raise ValueError(f"unknown sidecar frame kind {kind}")


@dataclass
class _SessionConfig:
    sample_rate: int = 16_000
    phrase_end_silence_s: float = 0.7


class _SessionState:
    def __init__(self) -> None:
        self.active = False
        self.config = _SessionConfig()
        self.next_sequence = 0
        self.speaking = False
        self.last_partial = ""
        self.lock = threading.Lock()


def _resolve_streaming_arch(ModelArch, raw: str):
    """Map AJAX_STT_MODEL to a Moonshine v2 streaming architecture only."""
    key = (raw or "SMALL_STREAMING").strip().upper().replace("-", "_")
    legacy = {
        "TINY",
        "BASE",
        "MOONSHINE/TINY",
        "MOONSHINE/BASE",
        "MOONSHINE_TINY",
        "MOONSHINE_BASE",
    }
    if key in legacy or key.startswith("MOONSHINE/"):
        raise RuntimeError(
            f"legacy Moonshine model {raw!r} is not supported; "
            "use Moonshine v2 streaming: SMALL_STREAMING (default), "
            "TINY_STREAMING, BASE_STREAMING, or MEDIUM_STREAMING"
        )
    mapping = {
        "TINY_STREAMING": ModelArch.TINY_STREAMING,
        "BASE_STREAMING": ModelArch.BASE_STREAMING,
        "SMALL_STREAMING": ModelArch.SMALL_STREAMING,
        "MEDIUM_STREAMING": ModelArch.MEDIUM_STREAMING,
        "SMALL": ModelArch.SMALL_STREAMING,
        "MEDIUM": ModelArch.MEDIUM_STREAMING,
    }
    if key not in mapping:
        raise RuntimeError(
            f"unknown AJAX_STT_MODEL {raw!r}; expected a Moonshine v2 streaming "
            "arch (default SMALL_STREAMING)"
        )
    return mapping[key]


def _load_stream():
    from moonshine_voice import ModelArch, Transcriber, get_model_for_language
    from moonshine_voice.transcriber import (
        LineCompleted,
        LineStarted,
        LineTextChanged,
    )

    model_arch = _resolve_streaming_arch(
        ModelArch, os.environ.get("AJAX_STT_MODEL", "SMALL_STREAMING")
    )
    language = os.environ.get("AJAX_STT_LANGUAGE", "en")
    model_path, resolved_arch = get_model_for_language(language, model_arch)
    if resolved_arch not in (
        ModelArch.TINY_STREAMING,
        ModelArch.BASE_STREAMING,
        ModelArch.SMALL_STREAMING,
        ModelArch.MEDIUM_STREAMING,
    ):
        raise RuntimeError(
            f"resolved non-streaming Moonshine arch {resolved_arch!r}; "
            "Ajax requires Moonshine v2 streaming models"
        )
    _log(f"loading Moonshine v2 {resolved_arch} from {model_path}")
    transcriber = Transcriber(
        model_path=str(model_path),
        model_arch=resolved_arch,
        update_interval=0.35,
    )
    stream = transcriber.create_stream(update_interval=0.35)
    return (
        transcriber,
        stream,
        LineStarted,
        LineTextChanged,
        LineCompleted,
        Transcriber.MOONSHINE_FLAG_FORCE_UPDATE,
    )


def main() -> int:
    try:
        import numpy as np
    except ImportError:
        _log("numpy missing")
        print("ajax-moonshine-sidecar: numpy is required", file=sys.stderr)
        return 2

    try:
        (
            transcriber,
            stream,
            LineStarted,
            LineTextChanged,
            LineCompleted,
            force_update_flag,
        ) = _load_stream()
    except Exception as error:  # noqa: BLE001 — surface startup failure to parent
        _log(f"model load failed: {error}")
        print(f"ajax-moonshine-sidecar: model load failed: {error}", file=sys.stderr)
        return 2

    session = _SessionState()
    audio_q: queue.Queue[bytes | None] = queue.Queue(maxsize=AUDIO_QUEUE_MAX)
    stop_worker = threading.Event()

    def on_transcript_event(event) -> None:
        with session.lock:
            if not session.active:
                return
            line = getattr(event, "line", None)
            text = (getattr(line, "text", None) or "").strip() if line is not None else ""
            if isinstance(event, LineStarted):
                if not session.speaking:
                    session.speaking = True
                    _emit({"type": "stt.speech_started"})
                return
            if isinstance(event, LineTextChanged):
                if text and text != session.last_partial:
                    session.last_partial = text
                    _emit(
                        {
                            "type": "stt.partial",
                            "sequence": session.next_sequence,
                            "text": text,
                        }
                    )
                return
            if isinstance(event, LineCompleted):
                if text:
                    _emit(
                        {
                            "type": "stt.final",
                            "sequence": session.next_sequence,
                            "text": text,
                        }
                    )
                    session.next_sequence += 1
                session.last_partial = ""
                if session.speaking:
                    _emit({"type": "stt.speech_ended"})
                    session.speaking = False

    def listener(event) -> None:
        try:
            on_transcript_event(event)
        except Exception as error:  # noqa: BLE001
            _log(f"listener error: {error}")

    stream.add_listener(listener)
    stream.start()
    _log("Moonshine v2 worker model ready")

    def ingest_loop() -> None:
        """Drain PCM into the streaming transcriber without blocking stdin reads."""
        while not stop_worker.is_set():
            try:
                item = audio_q.get(timeout=0.1)
            except queue.Empty:
                continue
            if item is None:
                continue
            with session.lock:
                if not session.active:
                    continue
                rate = session.config.sample_rate
            try:
                pcm = np.frombuffer(item, dtype="<i2").astype(np.float32) / 32768.0
                if pcm.size == 0:
                    continue
                stream.add_audio(pcm.tolist(), sample_rate=rate)
            except Exception as error:  # noqa: BLE001
                _log(f"add_audio failed: {error}")

    ingest_thread = threading.Thread(target=ingest_loop, name="stt-ingest", daemon=True)
    ingest_thread.start()

    stdin = sys.stdin.buffer

    def end_session(*, completed: bool) -> None:
        with session.lock:
            was_active = session.active
            session.active = False
            speaking = session.speaking
            session.speaking = False
            session.last_partial = ""
        while True:
            try:
                audio_q.get_nowait()
            except queue.Empty:
                break
        if was_active and speaking:
            _emit({"type": "stt.speech_ended"})
        try:
            stream.update_transcription(force_update_flag)
        except Exception as error:  # noqa: BLE001
            _log(f"force update failed: {error}")
        if completed:
            _emit({"type": "stt.completed"})

    while True:
        try:
            frame = _read_frame(stdin)
        except ValueError as error:
            _log(f"protocol error: {error}")
            return 1
        if frame is None:
            break

        kind, _sequence, payload = frame

        if kind == FRAME_START:
            try:
                config = json.loads(payload or b"{}")
            except json.JSONDecodeError:
                config = {}
            with session.lock:
                session.active = True
                session.next_sequence = 0
                session.speaking = False
                session.last_partial = ""
                session.config = _SessionConfig(
                    sample_rate=int(config.get("sampleRate") or 16_000),
                    phrase_end_silence_s=float(config.get("phraseEndSilenceMs") or 700)
                    / 1000.0,
                )
            _log(
                f"session start rate={session.config.sample_rate} "
                f"silence={session.config.phrase_end_silence_s}s"
            )
            _emit({"type": "stt.ready"})
            continue

        if kind == FRAME_CANCEL:
            end_session(completed=False)
            continue

        if kind == FRAME_FINALIZE:
            end_session(completed=True)
            continue

        if not payload:
            continue
        usable = len(payload) - (len(payload) % SAMPLE_WIDTH)
        chunk = payload[:usable]
        if not chunk:
            continue
        with session.lock:
            active = session.active
        if not active:
            continue
        try:
            audio_q.put_nowait(chunk)
        except queue.Full:
            _log("audio queue full; dropping frame (backpressure)")

    stop_worker.set()
    try:
        stream.stop()
    except Exception as error:  # noqa: BLE001
        _log(f"stream stop: {error}")
    try:
        stream.close()
    except Exception:
        pass
    try:
        transcriber.stop()
    except Exception:
        pass
    try:
        transcriber.close()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except BrokenPipeError:
        sys.exit(0)
